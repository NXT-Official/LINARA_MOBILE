{
  "expo": {
    "name": "LINARA_MOBILE",
    "slug": "linara-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "linaramobile",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Linara uses the camera to capture Palengke receipt photos and task completion evidence.",
          "photosPermission": "Linara accesses your photos to attach evidence images."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Linara uses the microphone to record your private voice notes. These stay yours -- managers can never see or hear them."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linara.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.linara.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "518629b9-1cfe-4f2d-afbe-da5249ae2630"
      }
    },
    "owner": "naaxtechs-team"
  }
}
